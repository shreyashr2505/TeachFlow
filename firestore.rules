rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }

    function userDoc() {
      return hasUserDoc() ? get(userPath()) : null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentRole() {
      return hasUserDoc() ? userDoc().data.role : null;
    }

    function isSuperAdmin() {
      return currentRole() == "super_admin";
    }

    function classMember(classId) {
      return hasUserDoc() &&
        userDoc().data.classIds is list &&
        classId in userDoc().data.classIds;
    }

    function classAdmin(classId) {
      return currentRole() == "admin" && classMember(classId);
    }

    function classTeacher(classId) {
      return currentRole() == "teacher" && classMember(classId);
    }

    function classStudent(classId) {
      return currentRole() == "student" && classMember(classId);
    }

    function classParent(classId) {
      return currentRole() == "parent" && classMember(classId);
    }

    function linkedStudentId() {
      return hasUserDoc() ? userDoc().data.linkedStudentId : null;
    }

    function inviteMatchesUser() {
      return isSignedIn() &&
        resource.data.email == request.auth.token.email;
    }

    function sharesClassAsAdmin(userData) {
      return currentRole() == "admin" &&
             userData.classIds is list &&
             hasUserDoc() && userDoc().data.classIds is list &&
             userData.classIds.hasAny(userDoc().data.classIds);
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if isSelf(userId) || isSuperAdmin() || sharesClassAsAdmin(resource.data);
      allow update: if isSelf(userId) || isSuperAdmin() || sharesClassAsAdmin(resource.data);
      allow delete: if isSuperAdmin() || sharesClassAsAdmin(resource.data);
    }

    match /classes/{classId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.adminId == request.auth.uid;

      allow update, delete: if classAdmin(classId) || isSuperAdmin();

      match /students/{studentId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || isSuperAdmin();
      }

      match /teachers/{teacherId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || isSuperAdmin();
      }

      match /lectures/{lectureId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || classTeacher(classId) || isSuperAdmin();
      }

      match /attendance/{attendanceId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || classTeacher(classId) || isSuperAdmin();
      }

      match /marks/{markId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || isSuperAdmin();
      }

      match /fees/{feeId} {
        allow read: if isSignedIn();
        allow write: if classAdmin(classId) || isSuperAdmin();
      }
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
